# ─── ESET API credentials (required) ───────────────────────────────────────
# Use a dedicated API user with a READ-ONLY permission set - not your console
# login. Cloud: ESET Business Account / ESET PROTECT Hub → create user →
# enable the "Integrations" toggle. The Administrator account cannot use the API.
ESET_USER=api-user@yourdomain.tld
ESET_PASSWORD=replace-me

# Cloud region of the ESET Business Account (eu/de/us/ca/jpn).
ESET_REGION=eu

# ─── Deployment kind (cloud vs on-prem ESET PROTECT) ───────────────────────
# cloud   — ESET Connect API at *.eset.systems (the default).
# onprem  — customer-hosted ESET PROTECT console (REST API on port 9443 by
#           default). Authenticates via POST /GetTokens.
ESET_DEPLOYMENT=cloud
# Required when ESET_DEPLOYMENT=onprem, e.g. https://protect.company.local:9443
ESET_ONPREM_SERVER_URL=
# Whether to verify the on-prem console's TLS cert. Default ON. Flip to
# false ONLY on trusted intranets where the console serves a self-signed
# cert — disabling verification opens the connection to MITM.
ESET_ONPREM_VERIFY_SSL=true
# true if the on-prem API user is an Active Directory account.
ESET_ONPREM_DOMAIN_USER=false

# ─── Cloudflare Access Service Token (on-prem only, optional) ──────────────
# Use these when the on-prem PROTECT console sits behind Cloudflare Access.
# Both values must be set together or both must be empty. Cloud requests
# never carry these headers.
ESET_ONPREM_CF_ACCESS_CLIENT_ID=
ESET_ONPREM_CF_ACCESS_CLIENT_SECRET=

# ─── Usage statistics ──────────────────────────────────────────────────────
# One JSON line per tool call (tool, success, status, duration - never
# arguments or results). Summarise with: eset-mcp-stats <file>
# Leave empty to disable. Ignored by `make up`: the container always writes
# /data/usage.jsonl in its volume (see `make stats`).
ESET_MCP_USAGE_LOG=~/.local/state/eset-mcp/usage.jsonl

# ─── MCP transport ─────────────────────────────────────────────────────────
# Ignored by `make up`: the container always runs HTTP on 127.0.0.1:8765.
# stdio — Claude Code / Claude Desktop start the server themselves.
# http  — Streamable HTTP on ESET_MCP_HTTP_HOST:ESET_MCP_HTTP_PORT/mcp.
#         Stateless and WITHOUT authentication - keep it on 127.0.0.1 or
#         behind an authenticating proxy.
ESET_MCP_TRANSPORT=stdio
ESET_MCP_HTTP_HOST=127.0.0.1
ESET_MCP_HTTP_PORT=8765

# ─── Response shaping (LLM context window protection) ──────────────────────
# Per-call payload byte cap. Large `list_*` results (e.g. pageSize=1000)
# can return >200 KB ≈ 50 k tokens — enough to overflow a model's context.
# When a response exceeds this, the server keeps every top-level field
# (especially `nextPageToken`) intact, trims items from the longest list,
# and attaches a `_capped` metadata block telling the agent how to continue.
# Set to 0 to disable (not recommended).
ESET_MCP_RESPONSE_BYTES_MAX=100000

# ─── Logging (stderr) ──────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR. INFO emits one event per tool call.
ESET_LOG_LEVEL=INFO
# text (human-readable) or json (JSON Lines for log shippers).
ESET_MCP_LOG_FORMAT=text

# ─── Prometheus metrics (HTTP transport only, optional) ────────────────────
# Requires the `metrics` extra (uv sync --extra metrics).
ESET_MCP_METRICS_ENABLED=false
ESET_MCP_METRICS_PATH=/metrics
